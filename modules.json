    {
      "id": "aefaq01",
      "name": "SSS",
      "path": "faq-1",
      "local": "body",
      "category": "faq",
      "version": "1.0.0",
      "icon": "quiz",
      "desing": {
        "max": "900px",
        "bgcolor": "#F5F8FC",
        "cardbg": "#ffffff",
        "bordercolor": "#e2e8f0",
        "titlecolor": "#1B3A6B",
        "textcolor": "#475569",
        "accent": "#2E6BFF",
        "badge": {
          "tr": "SSS",
          "en": "FAQ"
        },
        "title": {
          "tr": "Sıkça sorulan sorular",
          "en": "Frequently asked questions"
        },
        "description": {
          "tr": "Trafo, GES ve teklif süreçleri hakkında kısa yanıtlar.",
          "en": "Quick answers on transformers, solar and proposals."
        }
      },
      "data": [
        {
          "question": {
            "tr": "Trafo merkezi projelerinde hangi hizmetleri veriyorsunuz?",
            "en": "What do you deliver for substation projects?"
          },
          "answer": {
            "tr": "Saha organizasyonu, montaj, test, koruma ayarları ve devreye alma süreçlerini iş güvenliği standartlarına uygun yürütürüz.",
            "en": "We handle site works, assembly, testing and commissioning to safety standards."
          }
        },
        {
          "question": {
            "tr": "Güneş enerji santrali (GES) kurulumu yapıyor musunuz?",
            "en": "Do you build solar power plants?"
          },
          "answer": {
            "tr": "Evet. Panel montajı, kablolama, inverter odası ve SCADA entegrasyonu Arteng Enerji iş kapsamındadır.",
            "en": "Yes — mounting, cabling, inverter rooms and SCADA integration."
          }
        },
        {
          "question": {
            "tr": "Teklif almak için ne göndermem gerekir?",
            "en": "What do you need for a quote?"
          },
          "answer": {
            "tr": "Proje lokasyonu, güç/kapasite bilgisi, varsa tek hat şeması ve hedef teslim tarihi ile iletişim formundan bize ulaşmanız yeterlidir.",
            "en": "Share location, capacity, single-line diagram if available and target date via contact."
          }
        },
        {
          "question": {
            "tr": "Gaziantep dışındaki illerde çalışıyor musunuz?",
            "en": "Do you work outside Gaziantep?"
          },
          "answer": {
            "tr": "Merkezimiz Şehitkamil / Gaziantep olmakla birlikte Güneydoğu ve çevre illerde saha projeleri yürütüyoruz.",
            "en": "Based in Gaziantep; we execute field projects across the region."
          }
        },
        {
          "question": {
            "tr": "İletişim için hangi kanalları kullanabilirim?",
            "en": "How can I contact you?"
          },
          "answer": {
            "tr": "info@artengenerji.com adresine e-posta gönderebilir veya iletişim sayfasındaki harita linki ile adresimize ulaşabilirsiniz.",
            "en": "Email info@artengenerji.com or use the map on our contact page."
          }
        }
      ],
      "index": 13
    },
